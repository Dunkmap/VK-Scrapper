{
    "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
    "actorSpecification": 1,
    "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "required": ["postId", "ownerId", "text", "sourceUrl", "target", "scrapedAt"],
        "properties": {
            "postId": { "type": "string", "description": "VK post identifier as `ownerId_postId`." },
            "ownerId": { "type": "integer", "description": "Signed ID of the wall owner (negative for communities)." },
            "authorId": { "type": ["integer", "null"], "description": "Signed ID of the post author." },
            "author": { "type": ["object", "null"], "description": "Resolved author profile or community." },
            "wallOwner": { "type": ["object", "null"], "description": "Resolved owner of the wall the post sits on." },
            "text": { "type": "string", "description": "Post body text." },
            "postedAt": { "type": ["string", "null"], "description": "ISO-8601 publication timestamp." },
            "editedAt": { "type": ["string", "null"], "description": "ISO-8601 timestamp of the last edit." },
            "sourceUrl": { "type": "string", "description": "Canonical vk.com link to the post." },
            "stats": { "type": "object", "description": "Likes, comments, reposts, views and their sum." },
            "mediaTypes": { "type": "array", "items": { "type": "string" }, "description": "Attachment types in order." },
            "mediaCount": { "type": "integer", "description": "Number of attachments." },
            "attachments": { "type": "array", "description": "Attachments with direct URLs where VK exposes them." },
            "isRepost": { "type": "boolean", "description": "Whether the post reposts other content." },
            "repostChain": { "type": "array", "description": "Original posts, newest first." },
            "comments": { "type": "array", "description": "Comment threads (only when `includeComments` is on)." },
            "postType": { "type": ["string", "null"] },
            "isPinned": { "type": "boolean" },
            "isAd": { "type": "boolean" },
            "signer": { "type": ["object", "null"] },
            "postSource": { "type": ["object", "null"] },
            "geo": { "type": ["object", "null"] },
            "target": { "type": "string", "description": "The input target this post came from." },
            "targetType": { "type": "string", "enum": ["handle", "url", "ownerId"] },
            "scrapedAt": { "type": "string", "description": "ISO-8601 time this post was extracted." }
        }
    },
    "views": {
        "overview": {
            "title": "Overview",
            "description": "One row per post with the headline fields.",
            "transformation": {
                "fields": [
                    "postedAt",
                    "text",
                    "stats",
                    "mediaTypes",
                    "isRepost",
                    "sourceUrl",
                    "target"
                ],
                "flatten": ["stats"]
            },
            "display": {
                "component": "table",
                "properties": {
                    "postedAt": { "label": "Published", "format": "date" },
                    "text": { "label": "Text", "format": "text" },
                    "stats.likes": { "label": "Likes", "format": "number" },
                    "stats.comments": { "label": "Comments", "format": "number" },
                    "stats.reposts": { "label": "Reposts", "format": "number" },
                    "stats.views": { "label": "Views", "format": "number" },
                    "mediaTypes": { "label": "Media", "format": "array" },
                    "isRepost": { "label": "Repost", "format": "boolean" },
                    "sourceUrl": { "label": "Post URL", "format": "link" },
                    "target": { "label": "Target", "format": "text" }
                }
            }
        },
        "media": {
            "title": "Media",
            "description": "Attachments expanded to one row per attachment.",
            "transformation": {
                "fields": ["postId", "sourceUrl", "attachments"],
                "unwind": ["attachments"]
            },
            "display": {
                "component": "table",
                "properties": {
                    "postId": { "label": "Post ID", "format": "text" },
                    "sourceUrl": { "label": "Post URL", "format": "link" },
                    "attachments": { "label": "Attachment", "format": "object" }
                }
            }
        }
    }
}
