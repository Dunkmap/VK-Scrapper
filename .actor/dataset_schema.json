{
    "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
    "actorSpecification": 1,
    "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "required": ["postId", "ownerId", "text", "sourceUrl", "target", "scrapedAt"],
        "properties": {
            "postId": { "type": "string", "description": "VK post identifier as `ownerId_postId`." },
            "ownerId": { "type": "integer", "description": "Signed ID of the wall owner (negative for communities)." },
            "authorId": { "type": ["integer", "null"], "description": "Signed ID of the post author. API mode only." },
            "author": { "type": ["object", "null"], "description": "Resolved author profile or community. API mode only." },
            "wallOwner": { "type": ["object", "null"], "description": "Resolved owner of the wall. API mode only." },
            "text": { "type": "string", "description": "Post body text." },
            "postedAt": { "type": ["string", "null"], "description": "ISO-8601 publication timestamp in UTC." },
            "postedAtLabel": { "type": ["string", "null"], "description": "Date exactly as VK printed it. HTML mode only." },
            "editedAt": { "type": ["string", "null"], "description": "ISO-8601 timestamp of the last edit." },
            "sourceUrl": { "type": "string", "description": "Canonical vk.com link to the post." },
            "stats": { "type": "object", "description": "Likes, comments, reposts, views and their sum. Often null in HTML mode." },
            "mediaTypes": { "type": "array", "items": { "type": "string" }, "description": "Distinct attachment types." },
            "mediaCount": { "type": "integer", "description": "Number of attachments." },
            "attachments": { "type": "array", "description": "Attachments with VK object IDs and URLs." },
            "isRepost": { "type": "boolean", "description": "Whether the post reposts other content." },
            "repostChain": { "type": "array", "description": "Original posts, newest first. API mode only." },
            "comments": { "type": "array", "description": "Comment threads. API mode with `includeComments` only." },
            "isPinned": { "type": "boolean" },
            "isAd": { "type": "boolean", "description": "API mode only." },
            "geo": { "type": ["object", "null"], "description": "API mode only." },
            "target": { "type": "string", "description": "The input target this post came from." },
            "targetType": { "type": "string", "enum": ["handle", "url", "ownerId"] },
            "extractionMode": { "type": "string", "enum": ["html", "api"], "description": "Which mode produced this row." },
            "scrapedAt": { "type": "string", "description": "ISO-8601 time this post was extracted." }
        }
    },
    "views": {
        "overview": {
            "title": "Overview",
            "description": "One row per post with the headline fields.",
            "transformation": {
                "fields": ["postedAt", "text", "stats", "mediaTypes", "mediaCount", "isRepost", "sourceUrl"],
                "flatten": ["stats"]
            },
            "display": {
                "component": "table",
                "properties": {
                    "postedAt": { "label": "Published", "format": "date" },
                    "text": { "label": "Text", "format": "text" },
                    "stats.likes": { "label": "Likes", "format": "number" },
                    "stats.comments": { "label": "Comments", "format": "number" },
                    "stats.reposts": { "label": "Reposts", "format": "number" },
                    "stats.views": { "label": "Views", "format": "number" },
                    "mediaTypes": { "label": "Media", "format": "array" },
                    "mediaCount": { "label": "Files", "format": "number" },
                    "isRepost": { "label": "Repost", "format": "boolean" },
                    "sourceUrl": { "label": "Post URL", "format": "link" }
                }
            }
        },
        "media": {
            "title": "Media",
            "description": "Attachments expanded to one row per file.",
            "transformation": {
                "fields": ["postId", "postedAt", "sourceUrl", "attachments"],
                "unwind": ["attachments"]
            },
            "display": {
                "component": "table",
                "properties": {
                    "postId": { "label": "Post ID", "format": "text" },
                    "postedAt": { "label": "Published", "format": "date" },
                    "sourceUrl": { "label": "Post URL", "format": "link" },
                    "attachments.type": { "label": "Type", "format": "text" },
                    "attachments.id": { "label": "VK object ID", "format": "text" },
                    "attachments.url": { "label": "URL", "format": "link" }
                }
            }
        },
        "authors": {
            "title": "Authors",
            "description": "Who published what. Populated in API mode.",
            "transformation": {
                "fields": ["postedAt", "author", "text", "sourceUrl"],
                "flatten": ["author"]
            },
            "display": {
                "component": "table",
                "properties": {
                    "postedAt": { "label": "Published", "format": "date" },
                    "author.name": { "label": "Author", "format": "text" },
                    "author.url": { "label": "Profile", "format": "link" },
                    "text": { "label": "Text", "format": "text" },
                    "sourceUrl": { "label": "Post URL", "format": "link" }
                }
            }
        }
    }
}
